@@ -0,0 +1,119 @@
+// Copyright 2026 The Hydrogen Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_HYDROGEN_HYDROGEN_SPACES_CONTROLLER_H_
+#define CHROME_BROWSER_UI_HYDROGEN_HYDROGEN_SPACES_CONTROLLER_H_
+
+#include <map>
+#include <string>
+#include <vector>
+
+#include "base/callback_list.h"
+#include "base/memory/raw_ptr.h"
+#include "base/time/time.h"
+#include "base/timer/timer.h"
+#include "chrome/browser/ui/tabs/tab_strip_model_observer.h"
+#include "components/prefs/pref_change_registrar.h"
+#include "third_party/skia/include/core/SkColor.h"
+#include "ui/base/unowned_user_data/scoped_unowned_user_data.h"
+
+class BrowserWindowInterface;
+class PrefService;
+class TabStripModel;
+
+namespace content {
+class WebContents;
+}  // namespace content
+
+// A Hydrogen "space" is a named, accent-colored collection of tabs. Only one
+// space is active at a time; switching spaces swaps the visible tab set and,
+// after the memory-saver interval elapses, offloads the tabs that belong to
+// inactive spaces so that only the active space consumes memory.
+struct HydrogenSpace {
+  std::string id;
+  std::u16string name;
+  SkColor accent_color = SK_ColorTRANSPARENT;
+};
+
+// Owns the space model of a single browser window. Space metadata is
+// persisted in the profile prefs; the tab-to-space assignment is
+// session-scoped and is kept in memory only.
+class HydrogenSpacesController : public TabStripModelObserver {
+ public:
+  DECLARE_USER_DATA(HydrogenSpacesController);
+
+  HydrogenSpacesController(BrowserWindowInterface* browser_window,
+                         PrefService* pref_service);
+  HydrogenSpacesController(const HydrogenSpacesController&) = delete;
+  HydrogenSpacesController& operator=(const HydrogenSpacesController&) = delete;
+  ~HydrogenSpacesController();
+
+  static HydrogenSpacesController* From(BrowserWindowInterface* browser_window);
+
+  bool IsEnabled() const;
+  const std::vector<HydrogenSpace>& GetSpaces() const;
+  const std::string& GetActiveSpaceId() const;
+  const HydrogenSpace* GetActiveSpace() const;
+
+  // Delay after a space switch before inactive-space tabs are offloaded. A
+  // non-positive or disabled interval disables automatic offloading.
+  base::TimeDelta GetMemorySaverInterval() const;
+  int GetMemorySaverIntervalMinutes() const;
+
+  // Creates a new space, activates it, and persists it. The empty name is
+  // replaced with "Space".
+  void CreateSpace(const std::u16string& name, SkColor accent_color);
+  void RenameSpace(const std::string& space_id,
+                   const std::u16string& new_name);
+  void SetSpaceAccentColor(const std::string& space_id, SkColor accent_color);
+  // Deleting the active space activates the first remaining space. Deleting
+  // the last space is a no-op.
+  void DeleteSpace(const std::string& space_id);
+  void ActivateSpace(const std::string& space_id);
+
+  // Tab bookkeeping. Tabs that have no explicit space assigned are treated
+  // as belonging to the active space.
+  std::string GetSpaceForTab(content::WebContents* contents) const;
+  void SetTabSpace(content::WebContents* contents,
+                   const std::string& space_id);
+  int GetSpaceTabCount(const std::string& space_id) const;
+
+  // Offloads (discards) the eligible tabs of every space other than the
+  // active one. Used by the memory-saver timer and exposed for testing.
+  void DiscardTabsInInactiveSpaces();
+
+  using StateChangedCallback =
+      base::RepeatingCallback<void(HydrogenSpacesController*)>;
+  base::CallbackListSubscription RegisterOnStateChanged(
+      StateChangedCallback callback);
+
+ private:
+  // TabStripModelObserver:
+  void OnTabStripModelChanged(
+      TabStripModel* tab_strip_model,
+      const TabStripModelChange& change,
+      const TabStripSelectionChange& selection) override;
+
+  void LoadSpacesFromPrefs();
+  void SaveSpacesToPrefs();
+  void OnSpacePrefsChanged();
+  void RestartMemorySaverTimer();
+  void OnMemorySaverTimeout();
+  void NotifyStateChanged();
+
+  const raw_ptr<BrowserWindowInterface> browser_window_;
+  const raw_ptr<PrefService> pref_service_;
+
+  std::vector<HydrogenSpace> spaces_;
+  std::string active_space_id_;
+  std::map<raw_ptr<content::WebContents>, std::string> tab_spaces_;
+
+  base::OneShotTimer memory_saver_timer_;
+  PrefChangeRegistrar pref_change_registrar_;
+  base::RepeatingCallbackList<void(HydrogenSpacesController*)>
+      on_state_changed_callback_list_;
+  ui::ScopedUnownedUserData<HydrogenSpacesController> scoped_unowned_user_data_;
+};
+
+#endif  // CHROME_BROWSER_UI_HYDROGEN_HYDROGEN_SPACES_CONTROLLER_H_
