new file mode 100644
--- /dev/null
+++ b/chrome/browser/ui/hydrogen/hydrogen_spaces_controller.cc
@@ -0,0 +1,373 @@
+// Copyright 2026 The Hydrogen Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/hydrogen/hydrogen_spaces_controller.h"
+
+#include <algorithm>
+#include <optional>
+#include <utility>
+
+#include "base/json/json_reader.h"
+#include "base/json/json_writer.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/uuid.h"
+#include "base/values.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/common/pref_names.h"
+#include "components/prefs/pref_service.h"
+#include "content/public/browser/web_contents.h"
+
+namespace {
+
+constexpr char kDefaultSpaceId[] = "default";
+constexpr char16_t kDefaultSpaceName[] = u"Personal";
+constexpr SkColor kDefaultSpaceAccentColor =
+    SkColorSetARGB(0xFF, 0xEB, 0x55, 0x45);
+
+HydrogenSpace DefaultSpace() {
+  HydrogenSpace space;
+  space.id = kDefaultSpaceId;
+  space.name = kDefaultSpaceName;
+  space.accent_color = kDefaultSpaceAccentColor;
+  return space;
+}
+
+}  // namespace
+
+DEFINE_USER_DATA(HydrogenSpacesController);
+
+HydrogenSpacesController::HydrogenSpacesController(
+    BrowserWindowInterface* browser_window,
+    PrefService* pref_service)
+    : browser_window_(browser_window),
+      pref_service_(pref_service),
+      scoped_unowned_user_data_(browser_window->GetUnownedUserDataHost(),
+                                *this) {
+  pref_change_registrar_.Init(pref_service_);
+
+  pref_change_registrar_.AddMultiple(
+      {prefs::kHydrogenSpacesEnabled, prefs::kHydrogenSpacesMemorySaverInterval,
+       prefs::kHydrogenSpacesList, prefs::kHydrogenSpacesActive},
+      base::BindRepeating(&HydrogenSpacesController::OnSpacePrefsChanged,
+                          base::Unretained(this)));
+
+  if (TabStripModel* strip = browser_window_->GetTabStripModel()) {
+    strip->AddObserver(this);
+  }
+
+  LoadSpacesFromPrefs();
+  RestartMemorySaverTimer();
+}
+
+HydrogenSpacesController::~HydrogenSpacesController() {
+  if (TabStripModel* strip = browser_window_->GetTabStripModel()) {
+    strip->RemoveObserver(this);
+  }
+}
+
+// static
+HydrogenSpacesController* HydrogenSpacesController::From(
+    BrowserWindowInterface* browser_window) {
+  return Get(browser_window->GetUnownedUserDataHost());
+}
+
+bool HydrogenSpacesController::IsEnabled() const {
+  return pref_service_->GetBoolean(prefs::kHydrogenSpacesEnabled);
+}
+
+const std::vector<HydrogenSpace>& HydrogenSpacesController::GetSpaces() const {
+  return spaces_;
+}
+
+const std::string& HydrogenSpacesController::GetActiveSpaceId() const {
+  return active_space_id_;
+}
+
+const HydrogenSpace* HydrogenSpacesController::GetActiveSpace() const {
+  for (const HydrogenSpace& space : spaces_) {
+    if (space.id == active_space_id_) {
+      return &space;
+    }
+  }
+  return nullptr;
+}
+
+int HydrogenSpacesController::GetMemorySaverIntervalMinutes() const {
+  if (!IsEnabled()) {
+    return 0;
+  }
+  return std::max(0, pref_service_->GetInteger(
+                         prefs::kHydrogenSpacesMemorySaverInterval));
+}
+
+base::TimeDelta HydrogenSpacesController::GetMemorySaverInterval() const {
+  return base::Minutes(GetMemorySaverIntervalMinutes());
+}
+
+void HydrogenSpacesController::CreateSpace(const std::u16string& name,
+                                         SkColor accent_color) {
+  HydrogenSpace space;
+  space.id = base::Uuid::GenerateRandomV4().AsLowercaseString();
+  space.name = name.empty() ? u"Space" : name;
+  space.accent_color = accent_color;
+  spaces_.push_back(std::move(space));
+
+  SaveSpacesToPrefs();
+  ActivateSpace(spaces_.back().id);
+}
+
+void HydrogenSpacesController::RenameSpace(const std::string& space_id,
+                                         const std::u16string& new_name) {
+  for (HydrogenSpace& space : spaces_) {
+    if (space.id == space_id) {
+      space.name = new_name.empty() ? u"Space" : new_name;
+      SaveSpacesToPrefs();
+      NotifyStateChanged();
+      return;
+    }
+  }
+}
+
+void HydrogenSpacesController::SetSpaceAccentColor(const std::string& space_id,
+                                                 SkColor accent_color) {
+  for (HydrogenSpace& space : spaces_) {
+    if (space.id == space_id) {
+      space.accent_color = accent_color;
+      SaveSpacesToPrefs();
+      NotifyStateChanged();
+      return;
+    }
+  }
+}
+
+void HydrogenSpacesController::DeleteSpace(const std::string& space_id) {
+  if (spaces_.size() <= 1) {
+    return;
+  }
+
+  auto it = std::find_if(spaces_.begin(), spaces_.end(),
+                         [&space_id](const HydrogenSpace& space) {
+                           return space.id == space_id;
+                         });
+  if (it == spaces_.end()) {
+    return;
+  }
+
+  spaces_.erase(it);
+
+  if (active_space_id_ == space_id) {
+    active_space_id_ = spaces_.front().id;
+    pref_service_->SetString(prefs::kHydrogenSpacesActive, active_space_id_);
+  }
+
+  SaveSpacesToPrefs();
+  NotifyStateChanged();
+  RestartMemorySaverTimer();
+}
+
+void HydrogenSpacesController::ActivateSpace(const std::string& space_id) {
+  bool found = std::any_of(spaces_.begin(), spaces_.end(),
+                           [&space_id](const HydrogenSpace& space) {
+                             return space.id == space_id;
+                           });
+  if (!found) {
+    return;
+  }
+
+  active_space_id_ = space_id;
+  pref_service_->SetString(prefs::kHydrogenSpacesActive, active_space_id_);
+
+  // Surface the first tab of the newly active space so that switching spaces
+  // visibly changes the working tab set.
+  TabStripModel* strip = browser_window_->GetTabStripModel();
+  if (strip && strip->count() > 0) {
+    for (int i = 0; i < strip->count(); ++i) {
+      if (GetSpaceForTab(strip->GetWebContentsAt(i)) == space_id) {
+        strip->ActivateTabAt(i);
+        break;
+      }
+    }
+  }
+
+  NotifyStateChanged();
+  RestartMemorySaverTimer();
+}
+
+std::string HydrogenSpacesController::GetSpaceForTab(
+    content::WebContents* contents) const {
+  auto it = tab_spaces_.find(contents);
+  if (it != tab_spaces_.end()) {
+    return it->second;
+  }
+  return active_space_id_;
+}
+
+void HydrogenSpacesController::SetTabSpace(content::WebContents* contents,
+                                         const std::string& space_id) {
+  bool found = std::any_of(spaces_.begin(), spaces_.end(),
+                           [&space_id](const HydrogenSpace& space) {
+                             return space.id == space_id;
+                           });
+  if (!found) {
+    return;
+  }
+
+  tab_spaces_[contents] = space_id;
+}
+
+void HydrogenSpacesController::OnTabStripModelChanged(
+    TabStripModel* tab_strip_model,
+    const TabStripModelChange& change,
+    const TabStripSelectionChange& selection) {
+  switch (change.type()) {
+    case TabStripModelChange::kInserted:
+      for (const auto& contents_with_index : change.GetInsert()->contents) {
+        tab_spaces_[contents_with_index.contents] = active_space_id_;
+      }
+      break;
+    case TabStripModelChange::kReplaced:
+      if (const auto* replace = change.GetReplace()) {
+        auto it = tab_spaces_.find(replace->old_contents);
+        if (it != tab_spaces_.end()) {
+          tab_spaces_[replace->new_contents] = it->second;
+          tab_spaces_.erase(it);
+        }
+      }
+      break;
+    default:
+      break;
+  }
+}
+
+int HydrogenSpacesController::GetSpaceTabCount(
+    const std::string& space_id) const {
+  TabStripModel* strip = browser_window_->GetTabStripModel();
+  if (!strip) {
+    return 0;
+  }
+
+  int count = 0;
+  for (int i = 0; i < strip->count(); ++i) {
+    if (GetSpaceForTab(strip->GetWebContentsAt(i)) == space_id) {
+      ++count;
+    }
+  }
+  return count;
+}
+
+void HydrogenSpacesController::DiscardTabsInInactiveSpaces() {
+  if (!IsEnabled()) {
+    return;
+  }
+
+  TabStripModel* strip = browser_window_->GetTabStripModel();
+  if (!strip) {
+    return;
+  }
+
+  for (int i = 0; i < strip->count(); ++i) {
+    if (i == strip->active_index()) {
+      continue;
+    }
+    if (GetSpaceForTab(strip->GetWebContentsAt(i)) == active_space_id_) {
+      continue;
+    }
+    strip->ExecuteContextMenuCommand(i, TabStripModel::CommandDiscard);
+  }
+}
+
+base::CallbackListSubscription
+HydrogenSpacesController::RegisterOnStateChanged(
+    StateChangedCallback callback) {
+  return on_state_changed_callback_list_.Add(std::move(callback));
+}
+
+void HydrogenSpacesController::LoadSpacesFromPrefs() {
+  spaces_.clear();
+
+  const std::string raw = pref_service_->GetString(prefs::kHydrogenSpacesList);
+  if (!raw.empty()) {
+    std::optional<base::Value> parsed = base::JSONReader::Read(raw);
+    if (parsed && parsed->is_list()) {
+      for (const base::Value& item : parsed->GetList()) {
+        if (!item.is_dict()) {
+          continue;
+        }
+        const base::Value::Dict& dict = item.GetDict();
+        HydrogenSpace space;
+        if (const std::string* id = dict.FindString("id")) {
+          space.id = *id;
+        }
+        if (space.id.empty()) {
+          continue;
+        }
+        if (const std::string* name = dict.FindString("name")) {
+          space.name = base::UTF8ToUTF16(*name);
+        }
+        if (space.name.empty()) {
+          space.name = u"Space";
+        }
+        space.accent_color = static_cast<SkColor>(
+            dict.FindInt("accent").value_or(static_cast<int>(
+                kDefaultSpaceAccentColor)));
+        spaces_.push_back(std::move(space));
+      }
+    }
+  }
+
+  if (spaces_.empty()) {
+    spaces_.push_back(DefaultSpace());
+  }
+
+  active_space_id_ = pref_service_->GetString(prefs::kHydrogenSpacesActive);
+  bool active_found = std::any_of(spaces_.begin(), spaces_.end(),
+                                  [this](const HydrogenSpace& space) {
+                                    return space.id == active_space_id_;
+                                  });
+  if (!active_found) {
+    active_space_id_ = spaces_.front().id;
+  }
+}
+
+void HydrogenSpacesController::SaveSpacesToPrefs() {
+  base::Value::List list;
+  for (const HydrogenSpace& space : spaces_) {
+    base::Value::Dict dict;
+    dict.Set("id", space.id);
+    dict.Set("name", base::UTF16ToUTF8(space.name));
+    dict.Set("accent", static_cast<int>(space.accent_color));
+    list.Append(std::move(dict));
+  }
+  pref_service_->SetString(prefs::kHydrogenSpacesList,
+                           base::WriteJson(list).value_or("[]"));
+}
+
+void HydrogenSpacesController::OnSpacePrefsChanged() {
+  LoadSpacesFromPrefs();
+  NotifyStateChanged();
+  RestartMemorySaverTimer();
+}
+
+void HydrogenSpacesController::RestartMemorySaverTimer() {
+  memory_saver_timer_.Stop();
+
+  const base::TimeDelta interval = GetMemorySaverInterval();
+  if (!interval.is_positive()) {
+    return;
+  }
+
+  memory_saver_timer_.Start(
+      FROM_HERE, interval,
+      base::BindOnce(&HydrogenSpacesController::OnMemorySaverTimeout,
+                     base::Unretained(this)));
+}
+
+void HydrogenSpacesController::OnMemorySaverTimeout() {
+  DiscardTabsInInactiveSpaces();
+}
+
+void HydrogenSpacesController::NotifyStateChanged() {
+  on_state_changed_callback_list_.Notify(this);
+}
