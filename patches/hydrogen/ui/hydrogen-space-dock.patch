+// Copyright 2026 The Hydrogen Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/views/hydrogen/hydrogen_space_dock_view.h"
+
+#include <algorithm>
+#include <string>
+#include <utility>
+
+#include "cc/paint/paint_flags.h"
+#include "chrome/browser/ui/color/chrome_color_id.h"
+#include "chrome/browser/ui/hydrogen/hydrogen_spaces_controller.h"
+#include "chrome/browser/ui/views/hydrogen/frame_corner_radius.h"
+#include "ui/base/l10n/l10n_util.h"
+#include "ui/base/metadata/metadata_impl_macros.h"
+#include "ui/base/mojom/menu_source_type.mojom.h"
+#include "ui/gfx/canvas.h"
+#include "ui/gfx/color_utils.h"
+#include "ui/gfx/geometry/point_f.h"
+#include "ui/views/background.h"
+#include "ui/views/controls/button/button.h"
+#include "ui/views/controls/button/label_button.h"
+#include "ui/views/controls/menu/menu_runner.h"
+#include "ui/views/layout/box_layout.h"
+
+namespace {
+
+constexpr int kDotDiameter = 10;
+constexpr float kDotStrokeWidth = 1.5f;
+constexpr int kDotButtonSize = 24;
+constexpr int kDockBetweenChildSpacing = 4;
+constexpr float kDockTintAlpha = 0.14f;
+constexpr int kDeleteSpaceCommandId = 1;
+constexpr int kMoveActiveTabCommandId = 2;
+
+// Accent palette cycled through for newly created spaces.
+constexpr SkColor kNewSpaceAccents[] = {
+    SkColorSetARGB(0xFF, 0x3B, 0x82, 0xF6),  // blue
+    SkColorSetARGB(0xFF, 0x22, 0xC5, 0x5E),  // green
+    SkColorSetARGB(0xFF, 0xF5, 0x9E, 0x0B),  // amber
+    SkColorSetARGB(0xFF, 0xA8, 0x5C, 0xF8),  // violet
+    SkColorSetARGB(0xFF, 0xEC, 0x48, 0x99),  // pink
+    SkColorSetARGB(0xFF, 0x00, 0xB5, 0xAD),  // teal
+};
+
+SkColor NextSpaceAccent(size_t space_count) {
+  if (space_count == 0) {
+    return kNewSpaceAccents[0];
+  }
+  return kNewSpaceAccents[(space_count - 1) % std::size(kNewSpaceAccents)];
+}
+
+}  // namespace
+
+HydrogenSpaceDockView::DotButton::DotButton(HydrogenSpaceDockView* dock,
+                                          const std::string& space_id,
+                                          const std::u16string& name,
+                                          SkColor accent_color,
+                                          bool is_active)
+    : views::Button(
+          base::BindRepeating(&HydrogenSpaceDockView::ActivateSpace,
+                              base::Unretained(dock), space_id)),
+      dock_(dock),
+      space_id_(space_id),
+      accent_color_(accent_color),
+      is_active_(is_active) {
+  SetAccessibleName(name);
+  SetTooltipText(name);
+  SetPreferredSize(gfx::Size(kDotButtonSize, kDotButtonSize));
+  SetFocusBehavior(views::View::FocusBehavior::ACCESSIBLE_ONLY);
+}
+
+HydrogenSpaceDockView::DotButton::~DotButton() = default;
+
+void HydrogenSpaceDockView::DotButton::SetAccentColor(SkColor accent_color) {
+  accent_color_ = accent_color;
+  SchedulePaint();
+}
+
+void HydrogenSpaceDockView::DotButton::SetActive(bool is_active) {
+  if (is_active_ == is_active) {
+    return;
+  }
+  is_active_ = is_active;
+  SchedulePaint();
+}
+
+void HydrogenSpaceDockView::DotButton::OnPaint(gfx::Canvas* canvas) {
+  views::Button::OnPaint(canvas);
+
+  const gfx::PointF center(width() / 2.f, height() / 2.f);
+  cc::PaintFlags flags;
+  flags.setAntiAlias(true);
+
+  if (IsMouseHovered()) {
+    flags.setColor(SkColorSetA(accent_color_, 0x28));
+    canvas->DrawCircle(center, kDotDiameter, flags);
+  }
+
+  if (is_active_) {
+    flags.setColor(accent_color_);
+    flags.setStyle(cc::PaintFlags::kFill_Style);
+    canvas->DrawCircle(center, kDotDiameter / 2.f, flags);
+  } else {
+    flags.setColor(SkColorSetA(accent_color_, 0xB8));
+    flags.setStyle(cc::PaintFlags::kStroke_Style);
+    flags.setStrokeWidth(kDotStrokeWidth);
+    canvas->DrawCircle(center, kDotDiameter / 2.f, flags);
+  }
+}
+
+HydrogenSpaceDockView::HydrogenSpaceDockView(
+    HydrogenSpacesController* spaces_controller)
+    : spaces_controller_(spaces_controller) {
+  SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kHorizontal,
+      gfx::Insets::VH(8, 8), kDockBetweenChildSpacing));
+
+  add_button_ = AddChildView(std::make_unique<views::LabelButton>(
+      base::BindRepeating(&HydrogenSpaceDockView::AddSpace,
+                          base::Unretained(this)),
+      u"+"));
+  add_button_->SetTooltipText(u"New space");
+  add_button_->SetAccessibleName(u"New space");
+  add_button_->SetPreferredSize(gfx::Size(kDotButtonSize, kDotButtonSize));
+  add_button_->SetFocusBehavior(views::View::FocusBehavior::ACCESSIBLE_ONLY);
+
+  on_state_changed_subscription_ =
+      spaces_controller_->RegisterOnStateChanged(
+          base::BindRepeating(
+              [](HydrogenSpaceDockView* dock) { dock->OnSpacesChanged(); },
+              base::Unretained(this)));
+
+  OnSpacesChanged();
+}
+
+HydrogenSpaceDockView::~HydrogenSpaceDockView() = default;
+
+void HydrogenSpaceDockView::OnSpacesChanged() {
+  RebuildDots();
+  UpdateTint();
+  UpdateVisibility();
+}
+
+void HydrogenSpaceDockView::SetCollapsed(bool collapsed) {
+  if (collapsed_ == collapsed) {
+    return;
+  }
+  collapsed_ = collapsed;
+  UpdateVisibility();
+}
+
+void HydrogenSpaceDockView::OnThemeChanged() {
+  views::View::OnThemeChanged();
+  UpdateTint();
+}
+
+void HydrogenSpaceDockView::ShowContextMenuForView(
+    views::View* source,
+    const gfx::Point& point,
+    ui::mojom::MenuSourceType source_type) {
+  if (source == add_button_) {
+    return;
+  }
+
+  const auto* dot = static_cast<DotButton*>(source);
+  context_menu_space_id_ = dot->space_id();
+
+  context_menu_model_ = std::make_unique<ui::SimpleMenuModel>(this);
+  context_menu_model_->AddItem(
+      kDeleteSpaceCommandId,
+      l10n_util::GetStringUTF16(IDS_TAB_GROUP_HEADER_CXMENU_DELETE_GROUP));
+  context_menu_model_->AddItem(kMoveActiveTabCommandId,
+                               u"Move active tab here");
+
+  context_menu_runner_ = std::make_unique<views::MenuRunner>(
+      context_menu_model_.get(), views::MenuRunner::CONTEXT_MENU |
+                                     views::MenuRunner::IS_NESTED);
+  context_menu_runner_->RunMenuAt(
+      source->GetWidget(), /*button_controller=*/nullptr,
+      gfx::Rect(point, gfx::Size()), views::MenuAnchorPosition::kTopLeft,
+      source_type);
+}
+
+void HydrogenSpaceDockView::ExecuteCommand(int command_id, int event_flags) {
+  if (command_id == kDeleteSpaceCommandId) {
+    DeleteSpace(context_menu_space_id_);
+  } else if (command_id == kMoveActiveTabCommandId) {
+    spaces_controller_->AssignActiveTabToSpace(context_menu_space_id_);
+  }
+}
+
+void HydrogenSpaceDockView::OnMenuClosed(ui::SimpleMenuModel* source) {
+  context_menu_runner_.reset();
+  context_menu_model_.reset();
+}
+
+void HydrogenSpaceDockView::RebuildDots() {
+  while (children().size() > 1) {
+    RemoveChildViewT(children().front());
+  }
+
+  const std::string active_id = spaces_controller_->GetActiveSpaceId();
+  for (const HydrogenSpace& space : spaces_controller_->GetSpaces()) {
+    auto* dot = AddChildView(std::make_unique<DotButton>(
+        this, space.id, space.name, space.accent_color,
+        space.id == active_id));
+    dot->set_context_menu_controller(this);
+  }
+
+  // The "+" button always stays at the trailing end of the row.
+  ReorderChildView(add_button_, children().size() - 1);
+  InvalidateLayout();
+}
+
+void HydrogenSpaceDockView::AddSpace() {
+  const size_t space_count = spaces_controller_->GetSpaces().size();
+  spaces_controller_->CreateSpace(u"Space", NextSpaceAccent(space_count));
+}
+
+void HydrogenSpaceDockView::ActivateSpace(const std::string& space_id) {
+  spaces_controller_->ActivateSpace(space_id);
+}
+
+void HydrogenSpaceDockView::DeleteSpace(const std::string& space_id) {
+  spaces_controller_->DeleteSpace(space_id);
+}
+
+void HydrogenSpaceDockView::UpdateTint() {
+  if (!GetWidget()) {
+    return;
+  }
+
+  const HydrogenSpace* active = spaces_controller_->GetActiveSpace();
+  if (!active || active->accent_color == SK_ColorTRANSPARENT) {
+    SetBackground(views::CreateSolidBackground(
+        GetColorProvider()->GetColor(ui::kColorToolbar)));
+    return;
+  }
+
+  const SkColor base =
+      GetColorProvider()->GetColor(ui::kColorToolbar);
+  const SkColor tint =
+      color_utils::AlphaBlend(active->accent_color, base, kDockTintAlpha);
+  SetBackground(
+      views::CreateRoundedRectBackground(tint, GetGenericFrameRadius()));
+  SchedulePaint();
+}
