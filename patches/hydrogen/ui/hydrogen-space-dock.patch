+void BrowserView::UpdateSpacesEventMonitor() {
+  auto* controller = HydrogenSpacesController::From(browser_);
+  const bool spaces_enabled = controller && controller->IsEnabled();
+  if (!GetWidget() || !spaces_enabled) {
+    spaces_event_monitor_.reset();
+    spaces_swipe_accumulated_offset_ = 0;
+    last_spaces_switch_timestamp_ = base::TimeTicks();
+    return;
+  }
+
+  if (!spaces_event_monitor_) {
+    spaces_event_monitor_ = views::EventMonitor::CreateWindowMonitor(
+        this, GetWidget()->GetNativeWindow(),
+        {ui::EventType::kMousewheel});
+  }
+}
+
+void BrowserView::HandleSpacesWheelEvent(const ui::MouseWheelEvent* event) {
+  const int x_offset = event->x_offset();
+  if (x_offset == 0) {
+    return;
+  }
+
+  auto* controller = HydrogenSpacesController::From(browser_);
+  if (!controller || !controller->IsEnabled()) {
+    return;
+  }
+
+  const std::vector<HydrogenSpace>& spaces = controller->GetSpaces();
+  if (spaces.size() < 2) {
+    return;
+  }
+
+  // A two-finger swipe arrives as a burst of wheel events. Accumulate the
+  // horizontal offset, resetting on direction changes, and switch exactly
+  // once per swipe once the offset crosses a threshold.
+  const bool same_direction =
+      spaces_swipe_accumulated_offset_ == 0 ||
+      (spaces_swipe_accumulated_offset_ > 0) == (x_offset > 0);
+  spaces_swipe_accumulated_offset_ =
+      same_direction ? spaces_swipe_accumulated_offset_ + x_offset : x_offset;
+
+  constexpr int kSwipeThreshold = 60;
+  if (std::abs(spaces_swipe_accumulated_offset_) < kSwipeThreshold) {
+    return;
+  }
+  spaces_swipe_accumulated_offset_ = 0;
+
+  constexpr base::TimeDelta kMinSwipeInterval = base::Milliseconds(250);
+  const base::TimeTicks now = base::TimeTicks::Now();
+  if (!last_spaces_switch_timestamp_.is_null() &&
+      now - last_spaces_switch_timestamp_ < kMinSwipeInterval) {
+    return;
+  }
+  last_spaces_switch_timestamp_ = now;
+
+  const int direction = x_offset > 0 ? 1 : -1;
+  const std::string& active_id = controller->GetActiveSpaceId();
+  int active_index = 0;
+  for (size_t i = 0; i < spaces.size(); ++i) {
+    if (spaces[i].id == active_id) {
+      active_index = static_cast<int>(i);
+      break;
+    }
   }
+  const int next_index =
+      (active_index + direction + static_cast<int>(spaces.size())) %
+      static_cast<int>(spaces.size());
+  controller->ActivateSpace(spaces[next_index].id);
 }
 
