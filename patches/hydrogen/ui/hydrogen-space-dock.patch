+// Copyright 2026 The Hydrogen Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_HYDROGEN_HYDROGEN_SPACE_DOCK_VIEW_H_
+#define CHROME_BROWSER_UI_VIEWS_HYDROGEN_HYDROGEN_SPACE_DOCK_VIEW_H_
+
+#include <memory>
+#include <string>
+
+#include "base/callback_list.h"
+#include "base/memory/raw_ptr.h"
+#include "third_party/skia/include/core/SkColor.h"
+#include "ui/base/metadata/metadata_header_macros.h"
+#include "ui/base/models/simple_menu_model.h"
+#include "ui/gfx/geometry/point.h"
+#include "ui/views/context_menu_controller.h"
+#include "ui/views/view.h"
+
+class HydrogenSpacesController;
+
+namespace views {
+class Button;
+class LabelButton;
+class MenuRunner;
+}  // namespace views
+
+// A row of colored "space" dots shown at the top of the vertical tab strip.
+// Clicking a dot activates its space, right-clicking opens a context menu to
+// delete it, and the trailing "+" button creates a new space. The row is
+// subtly tinted with the accent color of the active space.
+class HydrogenSpaceDockView : public views::View,
+                            public views::ContextMenuController,
+                            public ui::SimpleMenuModel::Delegate {
+  METADATA_HEADER(HydrogenSpaceDockView, views::View)
+
+ public:
+  explicit HydrogenSpaceDockView(HydrogenSpacesController* spaces_controller);
+  HydrogenSpaceDockView(const HydrogenSpaceDockView&) = delete;
+  HydrogenSpaceDockView& operator=(const HydrogenSpaceDockView&) = delete;
+  ~HydrogenSpaceDockView() override;
+
+  void OnSpacesChanged();
+
+  // Hides the dock while the tab strip is collapsed so the dot row does not
+  // overflow the collapsed width.
+  void SetCollapsed(bool collapsed);
+
+  // views::View:
+  void OnThemeChanged() override;
+
+  // views::ContextMenuController:
+  void ShowContextMenuForView(
+      views::View* source,
+      const gfx::Point& point,
+      ui::mojom::MenuSourceType source_type) override;
+
+  // ui::SimpleMenuModel::Delegate:
+  void ExecuteCommand(int command_id, int event_flags) override;
+  void OnMenuClosed(ui::SimpleMenuModel* source) override;
+
+ private:
+  // A single colored dot. The active space's dot is filled with the space
+  // accent; inactive dots are stroked outlines of their accent.
+  class DotButton : public views::Button {
+   public:
+    DotButton(HydrogenSpaceDockView* dock,
+              const std::string& space_id,
+              const std::u16string& name,
+              SkColor accent_color,
+              bool is_active);
+    ~DotButton() override;
+
+    void SetAccentColor(SkColor accent_color);
+    void SetActive(bool is_active);
+
+    const std::string& space_id() const { return space_id_; }
+
+    // views::Button:
+    void OnPaint(gfx::Canvas* canvas) override;
+
+   private:
+    const raw_ptr<HydrogenSpaceDockView> dock_;
+    const std::string space_id_;
+    SkColor accent_color_;
+    bool is_active_;
+  };
+
+  void RebuildDots();
+  void AddSpace();
+  void ActivateSpace(const std::string& space_id);
+  void DeleteSpace(const std::string& space_id);
+  void UpdateTint();
+  void UpdateVisibility();
+
+  const raw_ptr<HydrogenSpacesController> spaces_controller_;
+  base::CallbackListSubscription on_state_changed_subscription_;
+  bool collapsed_ = false;
+
+  raw_ptr<views::LabelButton> add_button_ = nullptr;
+  std::unique_ptr<ui::SimpleMenuModel> context_menu_model_;
+  std::unique_ptr<views::MenuRunner> context_menu_runner_;
+  std::string context_menu_space_id_;
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_HYDROGEN_HYDROGEN_SPACE_DOCK_VIEW_H_
